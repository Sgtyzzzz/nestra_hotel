generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BookingStatus {
  PENDING
  UPCOMING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  UNPAID
  PAID
  REFUNDED
}

model User {
  id        String    @id @default(uuid())
  fullName  String
  email     String    @unique
  phone     String?
  password  String?
  role      String    @default("GUEST") // GUEST | ADMIN
  bookings  Booking[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Room {
  id          String    @id @default(uuid())
  slug        String    @unique // contoh: "superior", "deluks", "family-suite"
  name        String
  category    String
  description String
  sizeSqm     Int
  bedType     String
  maxGuests   Int
  basePrice   Int       // harga per malam dalam Rupiah (misal: 850000)
  totalUnits  Int       @default(5)
  images      String[]  // array URL foto kamar
  amenities   String[]  // daftar fasilitas kamar
  bookings    Booking[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Promo {
  id              String    @id @default(uuid())
  code            String    @unique // contoh: "NESTRALAMA", "AWAL15"
  title           String
  description     String
  discountPercent Int       // contoh: 20 untuk 20%
  minNights       Int       @default(1)
  validUntil      DateTime
  isActive        Boolean   @default(true)
  bookings        Booking[]
  createdAt       DateTime  @default(now())
}

model Booking {
  id             String        @id @default(uuid())
  bookingCode    String        @unique // contoh: "NST-261016-0842"
  userId         String?
  user           User?         @relation(fields: [userId], references: [id])
  roomId         String
  room           Room          @relation(fields: [roomId], references: [id])
  promoId        String?
  promo          Promo?        @relation(fields: [promoId], references: [id])

  // Detail Tamu (Step 2 Checkout)
  guestFirstName String
  guestLastName  String
  guestEmail     String
  guestPhone     String
  arrivalTime    String?
  specialRequest String?

  // Detail Menginap & Rincian Biaya
  checkIn        DateTime
  checkOut       DateTime
  nights         Int
  adults         Int           @default(2)
  roomSubtotal   Int
  discountAmount Int           @default(0)
  taxAmount      Int           // 11% pajak & layanan
  totalAmount    Int

  // Status & Pembayaran (Step 3 & 4)
  status         BookingStatus @default(UPCOMING)
  paymentStatus  PaymentStatus @default(PAID)
  paymentMethod  String?       // contoh: "BCA Virtual Account"
  paymentRef     String?       // contoh: "BCA-071026-0842"
  paidAt         DateTime?

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

model ContactMessage {
  id          String   @id @default(uuid())
  fullName    String
  email       String
  topic       String
  bookingCode String?
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("STAFF")
  createdAt DateTime @default(now())
}

model RoomUnit {
  id         String   @id @default(cuid())
  roomNumber String   @unique // "101" s/d "320"
  floor      Int      // 1, 2, 3
  category   String   // "Superior" | "Deluks"
  status     String   @default("READY") // READY | OCCUPIED | DIRTY | MAINTENANCE
  updatedAt  DateTime @updatedAt
}

model IncidentReport {
  id          String   @id @default(cuid())
  ticketCode  String   @unique // contoh: "KDL-032"
  title       String
  roomNumber  String?
  guestName   String?
  description String
  priority    String   @default("NORMAL") // NORMAL | HIGH | URGENT
  status      String   @default("OPEN")   // OPEN | ESCALATED | RESOLVED
  reportedBy  String   @default("Dimas Saputra")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}